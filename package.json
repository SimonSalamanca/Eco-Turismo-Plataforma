{
  "name": "ecoturismo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter ecoturismo-backend dev\" \"pnpm --filter eco-turismo-frontend dev\"",
    "dev:backend": "pnpm --filter ecoturismo-backend dev",
    "dev:frontend": "pnpm --filter eco-turismo-frontend dev",
    "install:all": "pnpm install",
    "build": "pnpm --filter eco-turismo-frontend build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
